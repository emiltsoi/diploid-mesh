#!/bin/sh
# Git pre-push hook: scan ref metadata, annotated tag messages, every commit
# tree, and every commit message being pushed.
# Install with: ln -sf ../../probes/privacy-pre-push .git/hooks/pre-push

set -u

ZERO_SHA="0000000000000000000000000000000000000000"
ROOT=$(git rev-parse --show-toplevel) || exit 1
SCANNER="$ROOT/probes/privacy_scan.py"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$ZERO_SHA" ]; then
        # Deletion can be remediation for a badly named ref. Never trap the
        # operator behind the very metadata they are trying to remove.
        continue
    fi

    range=""
    if [ "$remote_sha" != "$ZERO_SHA" ]; then
        range="$remote_sha..$local_sha"
    else
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
        if [ -n "$base" ]; then
            range="$base..$local_sha"
        fi
    fi

    echo "privacy pre-push: vetting $local_ref"

    # The remote ref is the public outcome. The local ref is scanned too as a
    # conservative hygiene gate; it is often the same name and may be exposed
    # through push output, branch tracking, or later automation.
    python3 "$SCANNER" --repo "$ROOT" --scan-ref="$local_ref" || status=1
    python3 "$SCANNER" --repo "$ROOT" --scan-ref="$remote_ref" || status=1

    case "$remote_ref" in
        refs/tags/*)
            python3 "$SCANNER" --repo "$ROOT" --scan-tag-object="$local_sha" || status=1
            ;;
    esac

    if [ -n "$range" ]; then
        python3 "$SCANNER" --repo "$ROOT" --range "$range" || status=1
    else
        python3 "$SCANNER" --repo "$ROOT" --tree "$local_sha" || status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "privacy pre-push: refused; sanitize the flagged commits before pushing" >&2
fi
exit "$status"
